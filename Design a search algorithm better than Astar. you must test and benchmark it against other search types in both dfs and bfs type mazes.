import random, time, math, heapq, sys

# ============================================================
# FAST PERFECT MAZE GENERATORS
# ============================================================

def gen_dfs_maze(n, seed):
    """Iterative recursive backtracker (DFS). Generates perfect maze."""
    rng = random.Random(seed)
    grid = [[False]*n for _ in range(n)]
    # step-2 grid: odd cells are actual cells
    for y in range(0, n, 2):
        for x in range(0, n, 2):
            grid[y][x] = True
    stack = [(0,0)]
    while stack:
        y,x = stack[-1]
        neighbors = []
        for dy,dx in [(0,2),(0,-2),(2,0),(-2,0)]:
            ny,nx = y+dy, x+dx
            if 0<=ny<n and 0<=nx<n and grid[ny][nx] is False:
                neighbors.append((ny,nx))
        if neighbors:
            ny,nx = rng.choice(neighbors)
            wy,wx = (y+ny)//2, (x+nx)//2
            grid[wy][wx] = True
            grid[ny][nx] = True
            stack.append((ny,nx))
        else:
            stack.pop()
    return grid

def gen_bfs_maze(n, seed):
    """Set-based Randomized Prim's. Generates perfect maze."""
    rng = random.Random(seed)
    grid = [[False]*n for _ in range(n)]
    grid[0][0] = True
    front = []
    fset = set()
    def add_front(y,x):
        for dy,dx in [(0,2),(0,-2),(2,0),(-2,0)]:
            ny,nx = y+dy, x+dx
            if 0<=ny<n and 0<=nx<n and not grid[ny][nx] and (ny,nx) not in fset:
                fset.add((ny,nx))
                front.append((ny,nx,(y+ny)//2,(x+nx)//2))
    add_front(0,0)
    while front:
        idx = rng.randrange(len(front))
        ny,nx,wy,wx = front[idx]
        front[idx] = front[-1]
        front.pop()
        fset.discard((ny,nx))
        if not grid[ny][nx]:
            grid[ny][nx] = True
            grid[wy][wx] = True
            add_front(ny,nx)
    return grid

def is_perfect(grid):
    """Check connectivity (flood fill) and that every cell is reachable."""
    n = len(grid)
    visited = [[False]*n for _ in range(n)]
    stack = [(0,0)]
    visited[0][0] = True
    while stack:
        y,x = stack.pop()
        for dy,dx in [(0,1),(0,-1),(1,0),(-1,0)]:
            ny,nx = y+dy, x+dx
            if 0<=ny<n and 0<=nx<n and grid[ny][nx] and not visited[ny][nx]:
                visited[ny][nx] = True
                stack.append((ny,nx))
    all_reachable = all(grid[y][x] == visited[y][x] for y in range(n) for x in range(n))
    return all_reachable

