def astar(grid, start, goal, weight=1.0):
    """A* (or WA* if weight != 1.0). Returns (cost, expansions, peak_mem, time_ms, success)."""
    n = len(grid)
    sy,sx = start
    gy,gx = goal
    g = {start: 0}
    parent = {start: None}
    h0 = abs(sy-gy) + abs(sx-gx)
    heap = [(weight*h0, 0, id(start), sy, sx)]
    closed = set()
    expansions = 0
    peak_mem = 1
    t0 = time.perf_counter()
    
    while heap:
        peak_mem = max(peak_mem, len(heap))
        f_val, g_val, _, y, x = heapq.heappop(heap)
        if (y,x) in closed:
            continue
        closed.add((y,x))
        expansions += 1
        if (y,x) == goal:
            t1 = time.perf_counter()
            return (g_val, expansions, peak_mem, (t1-t0)*1000, True)
        for dy,dx in [(0,1),(0,-1),(1,0),(-1,0)]:
            ny,nx = y+dy, x+dx
            if 0<=ny<n and 0<=nx<n and grid[ny][nx]:
                ng = g_val + 1
                if (ny,nx) not in g or ng < g[(ny,nx)]:
                    g[(ny,nx)] = ng
                    parent[(ny,nx)] = (y,x)
                    h = abs(ny-gy) + abs(nx-gx)
                    heapq.heappush(heap, (ng + weight*h, ng, id((ny,nx)), ny, nx))
    
    t1 = time.perf_counter()
    return (None, expansions, peak_mem, (t1-t0)*1000, False)

