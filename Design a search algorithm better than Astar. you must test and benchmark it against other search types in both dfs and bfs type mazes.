    fset = set()
    def add_front(y,x):
        for dy,dx in [(0,2),(0,-2),(2,0),(-2,0)]:
            ny,nx = y+dy, x+dx
            if 0<=ny<n and 0<=nx<n and grid[ny][nx] and (ny,nx) not in fset:
                fset.add((ny,nx))
                front.append((ny,nx,(y+ny)//2,(x+nx)//2))
    add_front(0,0)
    while front:
        idx = rng.randrange(len(front))
        ny,nx,wy,wx = front[idx]
        front[idx] = front[-1]; front.pop()
        fset.discard((ny,nx))
        if grid[ny][nx]:
            grid[ny][nx] = 0
            grid[wy][wx] = 0
            add_front(ny,nx)
    return grid

def gen_dfs_maze(n, seed):
    rng = random.Random(seed)
    grid = [[1]*n for _ in range(n)]
    stack = [(0,0)]
    grid[0][0] = 0
    while stack:
        y,x = stack[-1]
        neigh = []
        for dy,dx in [(0,2),(0,-2),(2,0),(-2,0)]:
            ny,nx = y+dy, x+dx
            if 0 <= ny < n and 0 <= nx < n and grid[ny][nx]:
                neigh.append((ny,nx,y+dy//2,x+dx//2))
        if neigh:
            ny,nx,wy,wx = rng.choice(neigh)
            grid[wy][wx] = 0
            grid[ny][nx] = 0
            stack.append((ny,nx))
        else:
            stack.pop()
    return grid

def check_suboptimality(grid, start, goal, eps):
    n = len(grid)
    g = {start: 0}
    open_heap = []
    heapq.heappush(open_heap, (eps * (abs(start[0]-goal[0])+abs(start[1]-goal[1])), 0, start[0], start[1]))
    closed = set()
    wa_cost = None
    wa_exp = 0
    while open_heap:
        f_val, g_val, y, x = heapq.heappop(open_heap)
        if (y,x) in closed: continue
        closed.add((y,x))
        wa_exp += 1
        if (y,x) == goal:
            wa_cost = g_val
            break
        for dy,dx in [(0,1),(0,-1),(1,0),(-1,0)]:
            ny,nx = y+dy, x+dx
            if 0<=ny<n and 0<=nx<n and not grid[ny][nx]:
                ng = g_val + 1
                if (ny,nx) not in g or ng < g[(ny,nx)]:
                    g[(ny,nx)] = ng
                    heapq.heappush(open_heap, (ng + eps * (abs(ny-goal[0])+abs(nx-goal[1])), ng, ny, nx))
    # BFS optimal
    dist = {start: 0}
    q = collections.deque([start])
    opt_cost = None
    while q:
        y,x = q.popleft()
        if (y,x) == goal:
            opt_cost = dist[(y,x)]
            break
        for dy,dx in [(0,1),(0,-1),(1,0),(-1,0)]:
            ny,nx = y+dy, x+dx
            if 0<=ny<n and 0<=nx<n and not grid[ny][nx] and (ny,nx) not in dist:
                dist[(ny,nx)] = dist[(y,x)] + 1
                q.append((ny,nx))
    return wa_cost, opt_cost, wa_exp

