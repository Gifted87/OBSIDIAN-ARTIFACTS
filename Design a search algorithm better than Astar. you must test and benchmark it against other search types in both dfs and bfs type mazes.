# Additional analysis: detailed breakdown of the one failing trial + theoretical verification
import random, time, math, heapq

# Re-run the failing configuration to get detail
def gen_dfs_maze(n, seed):
    rng = random.Random(seed)
    if n % 2 == 0: n = n + 1
    grid = [[False]*n for _ in range(n)]
    grid[0][0] = True
    stack = [(0, 0)]
    while stack:
        y, x = stack[-1]
        neighbors = []
        for dy, dx in [(0, 2), (0, -2), (2, 0), (-2, 0)]:
            ny, nx = y + dy, x + dx
            if 0 <= ny < n and 0 <= nx < n and not grid[ny][nx]:
                neighbors.append((ny, nx))
        if neighbors:
            ny, nx = rng.choice(neighbors)
            wy, wx = (y + ny) // 2, (x + nx) // 2
            grid[wy][wx] = True
            grid[ny][nx] = True
            stack.append((ny, nx))
        else:
            stack.pop()
    return grid

def is_perfect(grid):
    n = len(grid)
    visited = [[False]*n for _ in range(n)]
    stack = [(0, 0)]
    visited[0][0] = True
    while stack:
        y, x = stack.pop()
        for dy, dx in [(0, 1), (0, -1), (1, 0), (-1, 0)]:
            ny, nx = y + dy, x + dx
            if 0 <= ny < n and 0 <= nx < n and grid[ny][nx] and not visited[ny][nx]:
                visited[ny][nx] = True
                stack.append((ny, nx))
    for y in range(n):
        for x in range(n):
            if grid[y][x] != visited[y][x]:
                return False
    return True

def astar_detailed(grid, start, goal, weight=1.0):
    """Returns detailed metrics including f-values sampled at expansion."""
    n = len(grid)
    sy, sx = start
    gy, gx = goal
    g = {start: 0}
    h0 = abs(sy-gy) + abs(sx-gx)
    heap = [(weight * h0, 0, id(start), sy, sx)]
    closed = set()
    expansions = 0
    peak_mem = 1
    f_samples = []  # sample f-values of expanded nodes
    
    while heap:
        peak_mem = max(peak_mem, len(heap))
        f_val, g_val, _, y, x = heapq.heappop(heap)
        if (y, x) in closed:
            continue
        closed.add((y, x))
        expansions += 1
        f_samples.append(f_val)
        if (y, x) == goal:
            return {
                'cost': g_val,
                'expansions': expansions,
                'peak_mem': peak_mem,
                'f_samples': f_samples,
                'success': True,
                'closed_size': len(closed)
            }
        for dy, dx in [(0, 1), (0, -1), (1, 0), (-1, 0)]:
            ny, nx = y + dy, x + dx
            if 0 <= ny < n and 0 <= nx < n and grid[ny][nx]:
                ng = g_val + 1
                if (ny, nx) not in g or ng < g[(ny, nx)]:
                    g[(ny, nx)] = ng
                    h = abs(ny - gy) + abs(nx - gx)
                    heapq.heappush(heap, (ng + weight * h, ng, id((ny, nx)), ny, nx))
    
    return {'cost': None, 'expansions': expansions, 'peak_mem': peak_mem, 'f_samples': f_samples, 'success': False, 'closed_size': len(closed)}

