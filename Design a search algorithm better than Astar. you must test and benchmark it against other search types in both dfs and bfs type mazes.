```python
def gen_bfs(n, seed):
    rng = random.Random(seed)
    grid = [[False]*n for _ in range(n)]
    grid[0][0] = True
    front = []
    fset = set()
    def add_front(y,x):
        for dy,dx in [(0,2),(0,-2),(2,0),(-2,0)]:
            ny,nx = y+dy, x+dx
            if 0<=ny<n and 0<=nx<n and not grid[ny][nx] and (ny,nx) not in fset:
                fset.add((ny,nx))
                front.append((ny,nx,(y+ny)//2,(x+nx)//2))
    add_front(0,0)
    while front:
        idx = rng.randrange(len(front))
        ny,nx,wy,wx = front[idx]
        front[idx] = front[-1]; front.pop()
        fset.discard((ny,nx))
        if not grid[ny][nx]:
            grid[ny][nx] = True
            grid[wy][wx] = True
            add_front(ny,nx)
    return grid
```

