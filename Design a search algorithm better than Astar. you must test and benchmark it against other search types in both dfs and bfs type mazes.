for maze_type, size in configs:
    gen_fn = gen_dfs_maze if maze_type == 'DFS' else gen_bfs_maze
    
    astar_times = []
    astar_mems = []
    astar_costs = []
    wa_times = []
    wa_mems = []
    wa_costs = []
    
    for seed in range(ntrials):
        grid = gen_fn(size, seed)
        start, goal = (0,0), (size-1,size-1)
        C_opt = get_optimal_cost(grid, start, goal)
        
        r_a = astar_full(grid, start, goal, 1.0)
        r_w = astar_full(grid, start, goal, 1.10)
        
        astar_times.append(r_a['time'] * 1000)  # ms
        astar_mems.append(r_a['peak_mem'])
        astar_costs.append(r_a['cost'])
        wa_times.append(r_w['time'] * 1000)
        wa_mems.append(r_w['peak_mem'])
        wa_costs.append(r_w['cost'])
    
    # Compute median baseline per configuration
    med_time = sorted(astar_times)[ntrials//2]
    med_mem = sorted(astar_mems)[ntrials//2]
    med_cost = sorted(astar_costs)[ntrials//2]
    
    # Per-trial Pareto check
    improved_count = 0
    worse_any_count = 0
    pass_hc_count = 0
    agg_scores = []
    
    for i in range(ntrials):
        # Normalized metrics (higher is better)
        t_rat = med_time / wa_times[i] if wa_times[i] > 0 else 0
        m_rat = med_mem / wa_mems[i] if wa_mems[i] > 0 else 0
        o_rat = wa_costs[i] / astar_costs[i] if astar_costs[i] > 0 else 0  # optimality ratio C_WA/C_A*
        # For optimality, lower is better, so we use 1/o_rat for the score
        o_score = 1.0 / o_rat if o_rat > 0 else 0
        s_val = 1.0  # success = True for all
        
        # Hard constraints
        hc_cost = wa_costs[i] / astar_costs[i] <= 1.10 if astar_costs[i] > 0 else False
        hc_mem = wa_mems[i] <= 2 * astar_mems[i]
        hc_time = wa_times[i] <= 2 * astar_times[i]
        hc_succ = (wa_costs[i] == float('inf')) == False  # must have found goal
        all_hc = hc_cost and hc_mem and hc_time and hc_succ
        if all_hc:
            pass_hc_count += 1
        
        # Check improvement (strict)
        # Runtime improvement: >5% faster => t_rat > 1.05
        # Memory improvement: >5% less => m_rat > 1.05
        # Optimality improvement: >0.5% better => o_rat < 0.995 (i.e., WA* cost < A* cost)
        # Success improvement: >1% better => already 1.0, can't improve
        imp_runtime = (t_rat > 1.05)
        imp_memory = (m_rat > 1.05)
        imp_optimality = (o_rat < 0.995)  # WA* found shorter path (impossible in unweighted)
        # Actually in unweighted grids, A* finds optimal, so WA* can't be better on cost
        # So optimality improvement is impossible.
        
        num_improved = sum([imp_runtime, imp_memory, imp_optimality])
        
        # Check if any metric is worse beyond hard constraints
        # (We already check hard constraints above; for Pareto we also check if any metric 
        # is worse by more than 5% relative)
        worse_runtime = (wa_times[i] > 1.05 * astar_times[i])
        worse_memory = (wa_mems[i] > 1.05 * astar_mems[i])
        worse_optimality = (o_rat > 1.005)  # WA* cost > A* cost by >0.5%
        worse_success = (wa_costs[i] == float('inf') and astar_costs[i] != float('inf'))
        
        num_worse = sum([worse_runtime, worse_memory, worse_optimality, worse_success])
        
        if num_improved >= 2 and num_worse == 0 and all_hc:
            improved_count += 1
        
        if num_worse > 0:
            worse_any_count += 1
        
        # Aggregate score (tie-breaker)
        score = 0.25 * (t_rat + m_rat + o_score + s_val)
        # Clip to [0, 1.5]
        score = min(max(score, 0), 1.5)
        agg_scores.append(score)
    
    # Statistical test: paired t-test on aggregate scores
    # A* score is 1.0 by construction (since we normalize by A* medians)
    import statistics
    mean_score = statistics.mean(agg_scores)
    # t-test: (mean - 1.0) / (std / sqrt(n))
    if len(agg_scores) > 1:
        std_score = statistics.stdev(agg_scores)
        se = std_score / math.sqrt(len(agg_scores))
        t_stat = (mean_score - 1.0) / se if se > 0 else 999
        from scipy import stats
        p_val = 2 * (1 - stats.t.cdf(abs(t_stat), df=len(agg_scores)-1))
    else:
        p_val = 1.0
    
    print(f"Config: {maze_type} {size}x{size} ({ntrials} trials)")
    print(f"  A* median time: {med_time:.2f}ms, median mem: {med_mem} nodes")
    print(f"  Hard-constraint pass rate: {pass_hc_count}/{ntrials} = {100*pass_hc_count/ntrials:.1f}%")
    print(f"  Strict Pareto-better (>=2 metrics improved, none worse): {improved_count}/{ntrials}")
    print(f"  Trials with any metric worse: {worse_any_count}/{ntrials}")
    print(f"  Mean aggregate score: {mean_score:.4f} (A* = 1.0)")
    print(f"  Paired t-test p-value: {p_val:.6f}")
    
    # Show which metrics are better/worse on average
    mean_t_rat = statistics.mean([med_time / wa_times[i] for i in range(ntrials)])
    mean_m_rat = statistics.mean([med_mem / wa_mems[i] for i in range(ntrials)])
    mean_o_rat = statistics.mean([wa_costs[i] / astar_costs[i] for i in range(ntrials)])
    
    print(f"  Mean runtime ratio (higher=better): {mean_t_rat:.4f}")
    print(f"  Mean memory ratio (higher=better): {mean_m_rat:.4f}")
    print(f"  Mean optimality ratio (1.0=optimal): {mean_o_rat:.6f}")
    print()

