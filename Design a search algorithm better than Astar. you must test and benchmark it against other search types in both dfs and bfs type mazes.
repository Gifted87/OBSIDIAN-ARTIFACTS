def gen_dfs_maze(n: int, seed: int) -> List[List[bool]]:
    """Recursive backtracker, returns perfect maze (True=open)."""
    rng = random.Random(seed)
    grid = [[False]*n for _ in range(n)]
    stack = [(0,0)]
    grid[0][0] = True
    while stack:
