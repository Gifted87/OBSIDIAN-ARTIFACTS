def astar(grid: List[List[bool]], start: Tuple[int,int], goal: Tuple[int,int],
          weight: float = 1.0) -> Dict:
    """Standard A* with Manhattan heuristic. Returns metrics."""
    n = len(grid)
    open_heap = []
    g_score = {start: 0}
    open_set = {start}
    parent = {start: None}
    h = lambda y,x: abs(y-goal[0]) + abs(x-goal[1])
    heapq.heappush(open_heap, (weight * h(start[0],start[1]), 0, random.random(), start[0], start[1]))
    
    peak_open = 0
    closed = set()
    expansions = 0
    
    while open_heap:
        peak_open = max(peak_open, len(open_set))
        f, g, _, y, x = heapq.heappop(open_heap)
        if (y,x) in closed:
            if (y,x) in open_set: open_set.remove((y,x))
            continue
        closed.add((y,x))
        open_set.discard((y,x))
        expansions += 1
        
        if (y,x) == goal:
            # reconstruct
            path = []
            node = (y,x)
            while node is not None:
                path.append(node)
                node = parent[node]
            path.reverse()
            return {
                'path': path,
                'cost': len(path)-1,
                'expansions': expansions,
                'peak_memory': peak_open,
                'success': True
            }
        
        for dy,dx in [(0,1),(0,-1),(1,0),(-1,0)]:
            ny,nx = y+dy, x+dx
            if not (0 <= ny < n and 0 <= nx < n) or not grid[ny][nx]:
                continue
            ng = g + 1
            nh = h(ny,nx)
            nf = ng + weight * nh
            if (ny,nx) not in g_score or ng < g_score[(ny,nx)]:
                g_score[(ny,nx)] = ng
                parent[(ny,nx)] = (y,x)
                heapq.heappush(open_heap, (nf, ng, random.random(), ny, nx))
                open_set.add((ny,nx))
    
    return {'path': None, 'cost': None, 'expansions': expansions,
