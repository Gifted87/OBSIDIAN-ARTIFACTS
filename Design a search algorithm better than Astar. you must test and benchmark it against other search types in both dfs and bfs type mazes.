        if neigh:
            ny,nx = rng.choice(neigh)
            grid[(y+ny)//2][(x+nx)//2] = True
            grid[ny][nx] = True
            stack.append((ny,nx))
        else:
            stack.pop()
    return grid

def gen_bfs_maze(n: int, seed: int) -> List[List[bool]]:
    """Randomized Prim's (set-based), returns perfect maze (True=open)."""
    rng = random.Random(seed)
    grid = [[False]*n for _ in range(n)]
    grid[0][0] = True
    front = []  # (ny,nx,wy,wx)
    fset = set()
    def add_front(y,x):
