"""Check strict Pareto-dominance: WA* must improve >=2 metrics 
without worsening any beyond hard constraints, AND check aggregate score."""
import random, heapq, collections, time, math

# Reuse functions from previous cells (copied for isolation)
def gen_dfs_maze(n, seed):
    rng = random.Random(seed)
    grid = [[1]*n for _ in range(n)]
    stack = [(0,0)]
    grid[0][0] = 0
    while stack:
        y,x = stack[-1]
        neigh = []
        for dy,dx in [(0,2),(0,-2),(2,0),(-2,0)]:
            ny,nx = y+dy, x+dx
            if 0 <= ny < n and 0 <= nx < n and grid[ny][nx]:
                neigh.append((ny,nx,y+dy//2,x+dx//2))
        if neigh:
            ny,nx,wy,wx = rng.choice(neigh)
            grid[wy][wx] = 0
            grid[ny][nx] = 0
            stack.append((ny,nx))
        else:
            stack.pop()
    return grid

def gen_bfs_maze(n, seed):
    rng = random.Random(seed)
    grid = [[1]*n for _ in range(n)]
    grid[0][0] = 0
    front = []
    fset = set()
    def add_front(y,x):
        for dy,dx in [(0,2),(0,-2),(2,0),(-2,0)]:
            ny,nx = y+dy, x+dx
            if 0<=ny<n and 0<=nx<n and grid[ny][nx] and (ny,nx) not in fset:
                fset.add((ny,nx))
                front.append((ny,nx,(y+ny)//2,(x+nx)//2))
    add_front(0,0)
    while front:
        idx = rng.randrange(len(front))
        ny,nx,wy,wx = front[idx]
        front[idx] = front[-1]; front.pop()
        fset.discard((ny,nx))
        if grid[ny][nx]:
            grid[ny][nx] = 0
            grid[wy][wx] = 0
            add_front(ny,nx)
    return grid

def astar_full(grid, start, goal, heuristic_weight=1.0):
    n = len(grid)
    g = {start: 0}
    parent = {start: None}
    open_heap = []
    start_h = abs(start[0]-goal[0]) + abs(start[1]-goal[1])
    heapq.heappush(open_heap, (heuristic_weight * start_h, 0, id(start), start[0], start[1]))
    closed = set()
    peak_open = 0
    expansions = 0
    start_time = time.time()
    while open_heap:
        peak_open = max(peak_open, len(open_heap))
        f, g_val, _, y, x = heapq.heappop(open_heap)
        if (y,x) in closed:
            continue
        closed.add((y,x))
        expansions += 1
        if (y,x) == goal:
            elapsed = time.time() - start_time
            path = []
            node = (y,x)
            while node is not None:
                path.append(node)
                node = parent[node]
            return {'cost': g_val, 'expansions': expansions, 'peak_mem': peak_open,
                    'success': True, 'time': elapsed}
        for dy,dx in [(0,1),(0,-1),(1,0),(-1,0)]:
            ny,nx = y+dy, x+dx
            if 0 <= ny < n and 0 <= nx < n and not grid[ny][nx]:
                ng = g_val + 1
                if (ny,nx) not in g or ng < g[(ny,nx)]:
                    g[(ny,nx)] = ng
                    parent[(ny,nx)] = (y,x)
                    h = abs(ny-goal[0]) + abs(nx-goal[1])
                    f_new = ng + heuristic_weight * h
                    heapq.heappush(open_heap, (f_new, ng, id((ny,nx)), ny, nx))
    elapsed = time.time() - start_time
    return {'cost': float('inf'), 'expansions': expansions, 'peak_mem': peak_open,
            'success': False, 'time': elapsed}

def get_optimal_cost(grid, start, goal):
    n = len(grid)
    dist = {start: 0}
    q = collections.deque([start])
    while q:
        y,x = q.popleft()
        if (y,x) == goal:
            return dist[(y,x)]
        for dy,dx in [(0,1),(0,-1),(1,0),(-1,0)]:
            ny,nx = y+dy, x+dx
            if 0<=ny<n and 0<=nx<n and not grid[ny][nx] and (ny,nx) not in dist:
                dist[(ny,nx)] = dist[(y,x)] + 1
                q.append((ny,nx))
    return float('inf')

