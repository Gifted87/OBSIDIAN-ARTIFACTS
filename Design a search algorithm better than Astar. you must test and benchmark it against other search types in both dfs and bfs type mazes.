def astar(grid, start, goal, heuristic_weight=1.0):
    """A* with configurable heuristic weight (1.0 = optimal, >1 = WA*)."""
    n = len(grid)
    g = {start: 0}
    parent = {start: None}
    open_heap = []
    start_h = abs(start[0]-goal[0]) + abs(start[1]-goal[1])
    heapq.heappush(open_heap, (heuristic_weight * start_h, 0, start[0], start[1]))
    closed = set()
    peak_open = 0
    expansions = 0
    
    while open_heap:
        peak_open = max(peak_open, len(open_heap))
        f, g_val, y, x = heapq.heappop(open_heap)
        if (y,x) in closed:
            continue
        closed.add((y,x))
        expansions += 1
        
        if (y,x) == goal:
            # reconstruct
            path = []
            node = (y,x)
            while node is not None:
                path.append(node)
                node = parent[node]
            return {
