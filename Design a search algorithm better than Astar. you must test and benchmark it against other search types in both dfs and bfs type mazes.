import random, heapq, sys, math
from collections import deque

# ─── Perfect Maze Generators ───────────────────────────────────

def gen_dfs_maze(n: int, seed: int):
    """Recursive Backtracker (DFS-type). Returns n×n bool grid (True=pathable)."""
    rng = random.Random(seed)
    grid = [[False]*n for _ in range(n)]
    grid[0][0] = True
    stack = [(0,0)]
    while stack:
        y,x = stack[-1]
        nb = []
        for dy,dx in [(0,2),(0,-2),(2,0),(-2,0)]:
            ny,nx = y+dy, x+dx
            if 0 <= ny < n and 0 <= nx < n and not grid[ny][nx]:
                nb.append((ny,nx))
        if nb:
            ny,nx = rng.choice(nb)
            grid[(y+ny)//2][(x+nx)//2] = True
            grid[ny][nx] = True
            stack.append((ny,nx))
        else:
            stack.pop()
    return grid

def gen_bfs_maze(n: int, seed: int):
    """Randomized Prim's (BFS-type). Returns n×n bool grid (True=pathable)."""
    rng = random.Random(seed)
    grid = [[False]*n for _ in range(n)]
    grid[0][0] = True
    front = []
    fset = set()
    def addf(y,x):
        for dy,dx in [(0,2),(0,-2),(2,0),(-2,0)]:
            ny,nx = y+dy, x+dx
            if 0<=ny<n and 0<=nx<n and not grid[ny][nx] and (ny,nx) not in fset:
                fset.add((ny,nx))
                front.append((ny,nx,(y+ny)//2,(x+nx)//2))
    addf(0,0)
    while front:
        idx = rng.randrange(len(front))
        ny,nx,wy,wx = front[idx]
        front[idx] = front[-1]
        front.pop()
        fset.discard((ny,nx))
        if not grid[ny][nx]:
            grid[ny][nx] = True
            grid[wy][wx] = True
            addf(ny,nx)
    return grid

# ─── Search Algorithm ──────────────────────────────────────────

def wa_star(grid, start, goal, epsilon=1.10):
    """Weighted A* with heuristic inflation by epsilon."""
    n = len(grid)
    open_heap = []
    g_score = {start: 0}
    parent = {start: None}
    h = lambda y,x: abs(y-goal[0]) + abs(x-goal[1])
    
    heapq.heappush(open_heap, (epsilon * h(start[0], start[1]), 0, start[0], start[1]))
    peak_mem = 1
    expansions = 0
    closed = set()
    
    while open_heap:
        peak_mem = max(peak_mem, len(open_heap))
        f, g, y, x = heapq.heappop(open_heap)
        if (y,x) in closed: continue
        closed.add((y,x))
        expansions += 1
        if (y,x) == goal:
            path = []
            node = (y,x)
            while node is not None: path.append(node); node = parent[node]
            path.reverse()
            return (len(path)-1, expansions, peak_mem, True)
        for dy,dx in [(0,1),(0,-1),(1,0),(-1,0)]:
            ny,nx = y+dy, x+dx
            if not (0<=ny<n and 0<=nx<n) or not grid[ny][nx]: continue
            ng = g + 1
            if (ny,nx) not in g_score or ng < g_score[(ny,nx)]:
                g_score[(ny,nx)] = ng
                parent[(ny,nx)] = (y,x)
                heapq.heappush(open_heap, (ng + epsilon * h(ny,nx), ng, ny, nx))
    return (None, expansions, peak_mem, False)

# ─── Benchmark Runner ──────────────────────────────────────────

def run_benchmark():
