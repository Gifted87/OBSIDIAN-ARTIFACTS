            ny,nx = y+dy, x+dx
            if 0<=ny<n and 0<=nx<n and not grid[ny][nx] and (ny,nx) not in fset:
                fset.add((ny,nx))
                front.append((ny,nx,(y+ny)//2,(x+nx)//2))
    add_front(0,0)
    while front:
        idx = rng.randrange(len(front))
        ny,nx,wy,wx = front[idx]
        front[idx] = front[-1]; front.pop()
        fset.discard((ny,nx))
        if not grid[ny][nx]:
            grid[ny][nx] = True
            grid[wy][wx] = True
            add_front(ny,nx)
    return grid

def is_perfect(grid: List[List[bool]]) -> bool:
    n = len(grid)
    visited = set()
    stack = [(0,0)]
    while stack:
        y,x = stack.pop()
        if (y,x) in visited: continue
        visited.add((y,x))
        for dy,dx in [(0,1),(0,-1),(1,0),(-1,0)]:
            ny,nx = y+dy, x+dx
            if 0<=ny<n and 0<=nx<n and grid[ny][nx] and (ny,nx) not in visited:
                stack.append((ny,nx))
    expected = sum(sum(row) for row in grid)
    return len(visited) == expected

