def gen_dfs_maze(n, seed):
    """Iterative recursive backtracker on grid with step-2 carving."""
    rng = random.Random(seed)
    grid = [[1]*n for _ in range(n)]
    stack = [(0,0)]
    grid[0][0] = 0
    while stack:
        y,x = stack[-1]
        neigh = []
        for dy,dx in [(0,2),(0,-2),(2,0),(-2,0)]:
            ny,nx = y+dy, x+dx
            if 0 <= ny < n and 0 <= nx < n and grid[ny][nx]:
                neigh.append((ny,nx,y+dy//2,x+dx//2))
        if neigh:
            ny,nx,wy,wx = rng.choice(neigh)
            grid[wy][wx] = 0
            grid[ny][nx] = 0
            stack.append((ny,nx))
        else:
            stack.pop()
    return grid

def gen_bfs_maze(n, seed):
    """Set-based Randomized Prim's with O(1) frontier removal."""
    rng = random.Random(seed)
    grid = [[1]*n for _ in range(n)]
    grid[0][0] = 0
    front = []
    fset = set()
    def add_front(y,x):
        for dy,dx in [(0,2),(0,-2),(2,0),(-2,0)]:
            ny,nx = y+dy, x+dx
            if 0<=ny<n and 0<=nx<n and grid[ny][nx] and (ny,nx) not in fset:
                fset.add((ny,nx))
                front.append((ny,nx,(y+ny)//2,(x+nx)//2))
    add_front(0,0)
    while front:
        idx = rng.randrange(len(front))
        ny,nx,wy,wx = front[idx]
        front[idx] = front[-1]; front.pop()
        fset.discard((ny,nx))
        if grid[ny][nx]:
            grid[ny][nx] = 0
            grid[wy][wx] = 0
            add_front(ny,nx)
    return grid

def validate_perfect(grid):
    """Ensure exactly one path between any two cells via BFS flood fill."""
    n = len(grid)
    visited = [[False]*n for _ in range(n)]
    q = [(0,0)]
    visited[0][0] = True
    while q:
        y,x = q.pop()
        for dy,dx in [(0,1),(0,-1),(1,0),(-1,0)]:
            ny,nx = y+dy, x+dx
            if 0<=ny<n and 0<=nx<n and not grid[ny][nx] and not visited[ny][nx]:
                visited[ny][nx] = True
                q.append((ny,nx))
    pathable = sum(sum(1 for c in row if c==0) for row in grid)
    visited_count = sum(sum(1 for v in row if v) for row in visited)
    return visited_count == pathable

