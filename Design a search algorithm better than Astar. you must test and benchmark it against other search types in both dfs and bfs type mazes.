import random, time, math, heapq, sys

# ============================================================
# CORRECTED PERFECT MAZE GENERATORS (full grid, wall-carving)
# ============================================================

def gen_dfs_maze(n, seed):
    """Iterative recursive backtracker on a full n×n grid.
    Initially all cells are walls (False). We carve passages at even coordinates.
    n must be odd so that the grid has cells at even coordinates and walls at odd coordinates.
    """
    rng = random.Random(seed)
    # ensure n is odd
    if n % 2 == 0:
        n = n + 1
    # grid[y][x] = True means passable
    grid = [[False]*n for _ in range(n)]
    # carve starting cell
    grid[0][0] = True
    stack = [(0, 0)]
    while stack:
        y, x = stack[-1]
        neighbors = []
        for dy, dx in [(0, 2), (0, -2), (2, 0), (-2, 0)]:
            ny, nx = y + dy, x + dx
            if 0 <= ny < n and 0 <= nx < n and not grid[ny][nx]:
                neighbors.append((ny, nx))
        if neighbors:
            ny, nx = rng.choice(neighbors)
            wy, wx = (y + ny) // 2, (x + nx) // 2
            grid[wy][wx] = True
            grid[ny][nx] = True
            stack.append((ny, nx))
        else:
            stack.pop()
    return grid

def gen_bfs_maze(n, seed):
    """Set-based Randomized Prim's on a full n×n grid. n must be odd."""
    rng = random.Random(seed)
    if n % 2 == 0:
        n = n + 1
    grid = [[False]*n for _ in range(n)]
    grid[0][0] = True
    front = []  # list of (ny, nx, wy, wx)
    fset = set()
    def add_front(y, x):
        for dy, dx in [(0, 2), (0, -2), (2, 0), (-2, 0)]:
            ny, nx = y + dy, x + dx
            if 0 <= ny < n and 0 <= nx < n and not grid[ny][nx] and (ny, nx) not in fset:
                fset.add((ny, nx))
                front.append((ny, nx, (y+ny)//2, (x+nx)//2))
    add_front(0, 0)
    while front:
        idx = rng.randrange(len(front))
        ny, nx, wy, wx = front[idx]
        # swap-remove
        front[idx] = front[-1]
        front.pop()
        fset.discard((ny, nx))
        if not grid[ny][nx]:
            grid[ny][nx] = True
            grid[wy][wx] = True
            add_front(ny, nx)
    return grid

def is_perfect(grid):
    """Verify that the maze is a spanning tree (all passable cells reachable from start)."""
    n = len(grid)
    visited = [[False]*n for _ in range(n)]
    stack = [(0, 0)]
    visited[0][0] = True
    while stack:
        y, x = stack.pop()
        for dy, dx in [(0, 1), (0, -1), (1, 0), (-1, 0)]:
            ny, nx = y + dy, x + dx
            if 0 <= ny < n and 0 <= nx < n and grid[ny][nx] and not visited[ny][nx]:
                visited[ny][nx] = True
                stack.append((ny, nx))
    # Every passable cell must be visited, every wall must not be visited
    for y in range(n):
        for x in range(n):
            if grid[y][x] != visited[y][x]:
                return False
    return True

def count_passable(grid):
    return sum(sum(row) for row in grid)

