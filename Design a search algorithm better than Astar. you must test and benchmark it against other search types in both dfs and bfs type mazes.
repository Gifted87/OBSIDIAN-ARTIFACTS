                    g[(ny,nx)] = ng
                    parent[(ny,nx)] = (y,x)
                    h = abs(ny-goal[0]) + abs(nx-goal[1])
                    heapq.heappush(open_heap, (ng + eps * h, ng, ny, nx))
    
